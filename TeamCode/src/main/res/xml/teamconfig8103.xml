<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<!-- Drive-only Control Hub + four drive motors + Pinpoint. Full install required after XML changes. -->
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <goBILDA5201SeriesMotor name="frontLeft" port="0" />
            <goBILDA5201SeriesMotor name="frontRight" port="1" />
            <goBILDA5201SeriesMotor name="backLeft" port="2" />
            <goBILDA5201SeriesMotor name="backRight" port="3" />
            <goBILDAPinpoint name="pinpoint" port="0" bus="0" />
        </LynxModule>
    </LynxUsbDevice>
</Robot>
