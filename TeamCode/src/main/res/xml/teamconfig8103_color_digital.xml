<!-- Sensor-only example. Digital connector 0/1, BOTH channels configured as Digital Device.
     Port assignments below are provisional: bench-check red/blue and swap these NAMES
     if necessary, so colorPin0/colorPin1 refer to SENSOR pin numbers, not hub numbers. -->
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Control Hub" port="173">
            <DigitalDevice name="colorPin0" port="0" />
            <DigitalDevice name="colorPin1" port="1" />
        </LynxModule>
    </LynxUsbDevice>
</Robot>
