<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<!-- EXAMPLE: big-ball motor launcherLeft on Expansion Hub 0; small-ball launcherRight on 1.
     Connect each motor encoder to its own port. Verify hub addresses and wiring. -->
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <LynxModule name="Expansion Hub 1" port="1">
            <goBILDA6000RpmMotor name="launcherLeft" port="0" />
            <goBILDA6000RpmMotor name="launcherRight" port="1" />
        </LynxModule>
        <LynxModule name="Control Hub" port="173">
            <goBILDA312RpmMotor name="frontLeft" port="0" />
            <goBILDA312RpmMotor name="frontRight" port="1" />
            <goBILDA312RpmMotor name="backLeft" port="2" />
            <goBILDA312RpmMotor name="backRight" port="3" />
            <goBILDAPinpoint name="pinpoint" port="0" bus="0" />
        </LynxModule>
    </LynxUsbDevice>
    <Limelight3A name="limelight" serialNumber="*" />
</Robot>
